{
  "name": "island-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/content && tsc -p packages/sim && tsc -p packages/protocol && tsc -p apps/server && tsc -p tools/pacing && tsc -p tools/assets",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "pacing": "node --disable-warning=ExperimentalWarning tools/pacing/src/run.ts",
    "server": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "admin": "node --disable-warning=ExperimentalWarning apps/server/src/admin/cli.ts",
    "assets": "node --disable-warning=ExperimentalWarning tools/assets/src/cli.ts",
    "blender": "node --disable-warning=ExperimentalWarning tools/assets/src/blender.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
